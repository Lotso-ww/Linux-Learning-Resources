    {
      "id": "KMTtOfZis2H-RxGIDI7uN",
      "type": "text",
      "x": 1341.3334147135417,
      "y": 6867.377790662977,
      "width": 320,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAf",
      "roundness": null,
      "seed": 2097315333,
      "version": 293,
      "versionNonce": 1166090341,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773574189073,
      "link": null,
      "locked": false,
      "text": "一方写入的数据另一方就直接看到了",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "一方写入的数据另一方就直接看到了",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jQKyb4Vza15DRKJZeLo5F",
      "type": "text",
      "x": 22.613596598307367,
      "y": 6933.277815077039,
      "width": 674.239990234375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAi",
      "roundness": null,
      "seed": 1692316965,
      "version": 345,
      "versionNonce": 61459397,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773574189073,
      "link": null,
      "locked": false,
      "text": "结论1：共享内存，这种ipc资源，它的生命周期是随内核的，不是随进程的！",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "结论1：共享内存，这种ipc资源，它的生命周期是随内核的，不是随进程的！",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "CgQ2tQ6AudXNUJNGFxUeW",
      "type": "text",
      "x": 20.73360697428393,
      "y": 6979.677778455945,
      "width": 494,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAj",
      "roundness": null,
      "seed": 2143942277,
      "version": 324,
      "versionNonce": 40241957,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773574189073,
      "link": null,
      "locked": false,
      "text": "结论2：共享内存是进程间通信速度最快的，没有之一！",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "结论2：共享内存是进程间通信速度最快的，没有之一！",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "KgalJiXFFViJwCmbO_FZw",
      "type": "text",
      "x": 20.453592936197992,
      "y": 7023.677778455945,
      "width": 672.1599731445312,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAk",
      "roundness": null,
      "seed": 939492005,
      "version": 339,
      "versionNonce": 304307845,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "ytehr3MFcHeOL3R70heB-",
          "type": "arrow"
        }
      ],
      "updated": 1773574189073,
      "link": null,
      "locked": false,
      "text": "结论3：共享内存没有自带保护机制，任何挂接进程可以随时访问共享内存。",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "结论3：共享内存没有自带保护机制，任何挂接进程可以随时访问共享内存。",
      "autoResize": true,
      "lineHeight": 1.25
    },
