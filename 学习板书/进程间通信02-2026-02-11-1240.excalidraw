      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "我们把访问信号量的操作是P和V操作就是对信号量进行 --，++操作。",
      "autoResize": true,
      "lineHeight": 1.25
    },
