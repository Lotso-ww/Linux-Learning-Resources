    },
    {
      "id": "LNCnyYWUK0XCyTA60dsCU",
      "type": "text",
      "x": 767.423563639323,
      "y": 6809.477796766492,
      "width": 427.5999755859375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
