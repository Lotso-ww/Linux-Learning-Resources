      "link": null,
      "locked": false,
      "text": "我们进程间通信让不同的进程看到了同一份资源，但是新的问题也是从这里展开的！",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "我们进程间通信让不同的进程看到了同一份资源，但是新的问题也是从这里展开的！",
      "autoResize": true,
      "lineHeight": 1.25
    },
