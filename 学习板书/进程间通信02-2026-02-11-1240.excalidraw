      "updated": 1773577706073,
      "link": null,
      "locked": false,
      "text": "信号量就是一段属性数据和代码的集合 -- 类 ->  对象struct -> 变量",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "信号量就是一段属性数据和代码的集合 -- 类 ->  对象struct -> 变量",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
