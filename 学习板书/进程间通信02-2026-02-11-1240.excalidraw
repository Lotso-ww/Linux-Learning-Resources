      "index": "bC2",
      "roundness": null,
      "seed": 154969707,
      "version": 218,
      "versionNonce": 22651243,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773577596201,
      "link": null,
      "locked": false,
      "text": "申请信号量：\nvoid P()\n{\n    if(count > 0)\n        count--;\n    else\n        让当前进程阻塞\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "申请信号量：\nvoid P()\n{\n    if(count > 0)\n        count--;\n    else\n        让当前进程阻塞\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Xph7zQbDhVkdgEkPx7rHS",
      "type": "text",
      "x": 116.13352457682299,
      "y": 11200.977766248914,
      "width": 120,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
