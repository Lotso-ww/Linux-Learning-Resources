    {
      "id": "Q949w8ifA8prBaQmfroP1",
      "type": "text",
      "x": 18.53357950846356,
      "y": 9411.677564832898,
      "width": 780,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
