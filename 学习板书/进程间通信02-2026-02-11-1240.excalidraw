      "index": "bC3",
      "roundness": null,
      "seed": 234550603,
      "version": 52,
      "versionNonce": 1371029605,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773577622658,
      "link": null,
      "locked": false,
      "text": "释放信号量：\nvoid V()\n{\n    count++;\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "释放信号量：\nvoid V()\n{\n    count++;\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
