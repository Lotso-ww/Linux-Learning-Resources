    {
      "id": "1t1DMdW8kiiouoAt6qe6m",
      "type": "text",
      "x": 14.133440653483092,
      "y": 6872.177778455945,
      "width": 1260,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAd",
      "roundness": null,
      "seed": 297535621,
      "version": 425,
      "versionNonce": 885294501,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "gc2TrIww7HqkephZ7JJ97",
          "type": "arrow"
        }
      ],
      "updated": 1773574189073,
      "link": null,
      "locked": false,
      "text": "我们在使用共享内存的时候，有没有使用系统调用？？没有，因为共享内存映射到了我们进程的自己的用户空间中，用户可以直接用指针访问！",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "我们在使用共享内存的时候，有没有使用系统调用？？没有，因为共享内存映射到了我们进程的自己的用户空间中，用户可以直接用指针访问！",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
