    },
    {
      "id": "fjfxshBG2lRCaIargUuIe",
      "type": "text",
      "x": 121.33352152506518,
      "y": 10971.37772962782,
      "width": 204,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
