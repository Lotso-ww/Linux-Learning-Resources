    {
      "id": "cUCZu-ufzzVvzq2OvJAJw",
      "type": "text",
      "x": 83.33335494995117,
      "y": 6017.3333740234375,
      "width": 787.119873046875,
      "height": 100,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
