      "text": "def是abc的硬链接\nabc.s是abc的软链接",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def是abc的硬链接\nabc.s是abc的软链接",
