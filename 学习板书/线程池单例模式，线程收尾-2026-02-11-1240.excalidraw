    {
      "id": "kxEd4FHHvamRD1MmuU5kg",
      "type": "text",
      "x": 1357.7998046875,
      "y": 6864.500061035156,
      "width": 649.199951171875,
      "height": 75,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
