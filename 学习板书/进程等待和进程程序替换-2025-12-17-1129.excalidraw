      "versionNonce": 1816098597,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1766237669237,
      "link": null,
      "locked": false,
      "text": "不会变",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "不会变",
