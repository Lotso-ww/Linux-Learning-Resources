    {
      "id": "MLSV0ycqoFrI5eYnvpi9i",
      "type": "text",
      "x": 63.20014572143555,
      "y": 100.4000358581543,
      "width": 340,
      "height": 100,
      "angle": 0,
      "strokeColor": "#e03131",
