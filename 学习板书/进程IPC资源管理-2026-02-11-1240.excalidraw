    },
    {
      "id": "aW9cg3CHgcDQhtPniklxH",
      "type": "rectangle",
      "x": 19.199999809265023,
      "y": 2626.7999877929688,
      "width": 660.0000123977662,
      "height": 125.59997558593753,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
