      "text": "每一个进程都会打开标准输入,标准输出,标准错误，0,1,2\n",
      "fontSize": 23.466674804687504,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "每一个进程都会打开标准输入,标准输出,标准错误，0,1,2\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
