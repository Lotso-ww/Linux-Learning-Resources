      "isDeleted": false,
      "boundElements": [],
      "updated": 1769847038913,
      "link": null,
      "locked": false,
      "text": "举个直观的例子",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "举个直观的例子",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "HVZNSU9R8AvBsdu3Kq4gA",
      "type": "text",
      "x": 800.0000610351562,
      "y": 2647.5,
      "width": 140,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
