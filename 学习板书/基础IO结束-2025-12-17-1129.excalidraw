      "lineHeight": 1.25
    },
    {
      "id": "0bYKbkPy_v7q_OwRUIGi8",
      "type": "text",
      "x": 132,
      "y": 2793,
      "width": 558.2599487304688,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9q",
      "roundness": null,
      "seed": 1617700128,
      "version": 139,
      "versionNonce": 651389216,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "t6ThwM9PQfmN9WkhN9z66",
          "type": "arrow"
        }
      ],
      "updated": 1769847202414,
      "link": null,
      "locked": false,
      "text": "1. 提高用户拷贝数据的效率, 避免用户直接(对硬件)进行IO访问\n2. 提供OS真实的IO效率",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. 提高用户拷贝数据的效率, 避免用户直接(对硬件)进行IO访问\n2. 提供OS真实的IO效率",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "RCllXqKitxpzxVmMOyxi0",
      "type": "text",
      "x": 791.5468139648438,
      "y": 2555.3333740234375,
      "width": 782.239990234375,
      "height": 50,
      "angle": 0,
