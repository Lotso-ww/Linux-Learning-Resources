      "isDeleted": false,
      "boundElements": [],
      "updated": 1769753839389,
      "link": null,
      "locked": false,
      "text": "从最小的没有被使用过的下标开始分配，分配下标需要在系统角度连续",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "从最小的没有被使用过的下标开始分配，分配下标需要在系统角度连续",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "3Ri0ERy3zEbJx4OBEsuj-",
      "type": "text",
      "x": 115.33333587646484,
      "y": -400.6666259765625,
      "width": 739.119873046875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4p",
      "roundness": null,
      "seed": 1628214496,
      "version": 161,
      "versionNonce": 1360391392,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769753899168,
      "link": null,
      "locked": false,
      "text": "eg. close(0)，那么我创建的第一个文件fd就会是0，然后后面再创建还是从3再开始",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "eg. close(0)，那么我创建的第一个文件fd就会是0，然后后面再创建还是从3再开始",
      "autoResize": true,
      "lineHeight": 1.25
    },
