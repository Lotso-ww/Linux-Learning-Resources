    {
      "id": "s5UR0pPx4UnhOv1-RX2Wj",
      "type": "text",
      "x": 1392.1780090332031,
      "y": 10112.277835422092,
      "width": 120,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
