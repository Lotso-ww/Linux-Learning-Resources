    {
      "id": "PPOSOP2GO05LzrEHKTnR2",
      "type": "text",
      "x": 1115.350082397461,
      "y": -537.6999969482422,
      "width": 378.8999328613281,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
