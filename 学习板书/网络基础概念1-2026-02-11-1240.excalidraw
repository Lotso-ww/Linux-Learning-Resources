    {
      "id": "Bks8s-ueHlZaclEc7jmNM",
      "type": "text",
      "x": 726.800048828125,
      "y": 8255.09994506836,
      "width": 80,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
