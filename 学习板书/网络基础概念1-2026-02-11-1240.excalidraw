      "roundness": null,
      "seed": 751766602,
      "version": 117,
      "versionNonce": 993523850,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776686189516,
      "link": null,
      "locked": false,
      "text": "- 逻辑上，是两个人直接通信的，同层之间直接通信",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- 逻辑上，是两个人直接通信的，同层之间直接通信",
      "autoResize": true,
      "lineHeight": 1.25
    },
