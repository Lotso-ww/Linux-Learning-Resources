      "seed": 2049374794,
      "version": 38,
      "versionNonce": 82539914,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776684633865,
      "link": null,
      "locked": false,
      "text": "工具的出现是为了降低使用的门槛。",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "工具的出现是为了降低使用的门槛。",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4ukBxh6y8kJs7p7Ad7_7w",
      "type": "text",
      "x": 631.3800964355469,
      "y": 712.5000610351562,
      "width": 551.6399536132812,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "brS",
      "roundness": null,
      "seed": 1536436054,
      "version": 78,
      "versionNonce": 702021654,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776684633865,
      "link": null,
      "locked": false,
      "text": "操作系统 (OS)：为了让我们更方便地使用复杂的计算机硬件。",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "操作系统 (OS)：为了让我们更方便地使用复杂的计算机硬件。",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jCiWdsMDQ9aa8U1KipA0n",
      "type": "text",
      "x": 627.8501586914062,
      "y": 752.4000244140625,
      "width": 625.8997802734375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "brT",
      "roundness": null,
      "seed": 1956978954,
      "version": 83,
      "versionNonce": 2142778442,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776684633865,
      "link": null,
      "locked": false,
      "text": "AI框架 (如 LangChain, LangGraph)：现在的开发者不再需要从底层逻\n辑去写大模型（LLM）调用，而是通过这些框架更高效地利用AI能力。",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AI框架 (如 LangChain, LangGraph)：现在的开发者不再需要从底层逻辑去写大模型（LLM）调用，而是通过这些框架更高效地利用AI能力。",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "eiWf5lJfL8LK8ijDnv3ta",
      "type": "text",
      "x": 630.0000610351562,
      "y": 817.5000610351562,
      "width": 100,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "brU",
      "roundness": null,
      "seed": 1820380310,
      "version": 72,
      "versionNonce": 508267862,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776684633865,
      "link": null,
      "locked": false,
      "text": "逻辑递进：",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "逻辑递进：",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "DJL6uqmWykqDXLLxIHKWO",
      "type": "text",
      "x": 667.5800628662109,
      "y": 854.7000732421875,
      "width": 370.4399719238281,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "brV",
      "roundness": null,
      "seed": 842035146,
      "version": 72,
      "versionNonce": 1744771850,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776684633865,
      "link": null,
      "locked": false,
      "text": "硬件发展 -> 产生协作需求 -> 产生网络。",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "硬件发展 -> 产生协作需求 -> 产生网络。",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "7s7voglNB-ysUNtBFhqjy",
      "type": "text",
      "x": 671.3700561523438,
      "y": 892.7000122070312,
      "width": 554.8599853515625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "brW",
      "roundness": null,
      "seed": 455526870,
      "version": 49,
      "versionNonce": 1868264086,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776684633865,
      "link": null,
      "locked": false,
      "text": "网络发展 -> 产生大量数据 -> 催生复杂的软件系统与AI框架。",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "网络发展 -> 产生大量数据 -> 催生复杂的软件系统与AI框架。",
      "autoResize": true,
      "lineHeight": 1.25
    },
