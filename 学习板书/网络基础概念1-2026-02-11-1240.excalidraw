      "isDeleted": false,
      "boundElements": [],
      "updated": 1776683663636,
      "link": null,
      "locked": false,
      "text": "2. 先有局域网，后有广域网",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. 先有局域网，后有广域网",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
