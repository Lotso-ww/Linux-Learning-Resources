      "link": null,
      "locked": false,
      "text": "3. 局域网通信的方式，有很多种。",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. 局域网通信的方式，有很多种。",
