    {
      "id": "xI392K6lTIx03Ornex-D-",
      "type": "text",
      "x": 632.800048828125,
      "y": 672.9000244140625,
      "width": 320,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
