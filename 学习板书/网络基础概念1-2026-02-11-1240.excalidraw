    {
      "id": "wHFg4C7YFrZVF0AbwJMAS",
      "type": "text",
      "x": 1221.8902587890625,
      "y": 3985.4666544596353,
      "width": 796.219970703125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bs6",
