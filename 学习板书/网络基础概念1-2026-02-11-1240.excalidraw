    {
      "id": "70uaBYBjCjnBuiI7BgbdQ",
      "type": "text",
      "x": 811.599853515625,
      "y": 4106.7666269938145,
      "width": 660,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
