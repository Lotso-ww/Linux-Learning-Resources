      "text": "进程间通信的本质前提：先要让不同的进程，看到同一份资源",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "进程间通信的本质前提：先要让不同的进程，看到同一份资源",
      "autoResize": true,
      "lineHeight": 1.25
    },
