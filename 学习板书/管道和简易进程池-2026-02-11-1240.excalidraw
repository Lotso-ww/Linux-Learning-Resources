      "isDeleted": false,
      "boundElements": [],
      "updated": 1770790100716,
      "link": null,
      "locked": false,
      "text": "以文件的形式，继承给子进程，通信方案 - 管道！！！",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "以文件的形式，继承给子进程，通信方案 - 管道！！！",
      "autoResize": true,
      "lineHeight": 1.25
    },
