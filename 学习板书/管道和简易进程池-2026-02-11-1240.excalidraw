      "link": null,
      "locked": false,
      "text": "一个进程想把自己的数据，发送给另一个进程是一件比较困难的事情 -- 至少在目前!",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "一个进程想把自己的数据，发送给另一个进程是一件比较困难的事情 -- 至少在目前!",
      "autoResize": true,
      "lineHeight": 1.25
    },
