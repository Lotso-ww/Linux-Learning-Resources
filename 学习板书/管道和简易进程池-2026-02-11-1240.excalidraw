    {
      "id": "NJ1jxiySFa78EukZlgE_6",
      "type": "text",
      "x": -838.1697341209311,
      "y": -8547.364212903953,
      "width": 280,
      "height": 100,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
