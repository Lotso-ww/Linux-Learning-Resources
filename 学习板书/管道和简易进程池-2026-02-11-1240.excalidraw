    },
    {
      "id": "lrxUbEx4nUxVuJ8bCQebd",
      "type": "text",
      "x": -171.50303185042333,
      "y": -6527.364212903953,
      "width": 502.03997802734375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
