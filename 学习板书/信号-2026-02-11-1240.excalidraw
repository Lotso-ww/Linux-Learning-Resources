    {
      "id": "W9YEWJVXQRgjt0wDzIsHo",
      "type": "text",
      "x": 899.5314595047385,
      "y": 5843.914899999104,
      "width": 781.679931640625,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGp",
