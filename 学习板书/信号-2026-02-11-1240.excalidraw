    {
      "id": "tP7O36xYXjjCD6EU0qVjS",
      "type": "text",
      "x": 1505.171474153176,
      "y": 7202.014875585041,
      "width": 500,
      "height": 25,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bHp",
      "roundness": null,
      "seed": 1320868824,
      "version": 80,
      "versionNonce": 985311400,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1773798185724,
      "link": null,
      "locked": false,
      "text": "操作系统将硬件异常抽象为信号，统一了错误通知机制。",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "操作系统将硬件异常抽象为信号，统一了错误通知机制。",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "a1E03TOUrsoRKilPGiAci",
      "type": "text",
      "x": 1365.171474153176,
      "y": 7259.514875585041,
      "width": 780,
      "height": 50,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bHq",
      "roundness": null,
      "seed": 869494184,
      "version": 33,
      "versionNonce": 1646237144,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1773798185724,
      "link": null,
      "locked": false,
      "text": "进程可以选择捕获并处理这些信号，从而在异常发生时执行自定义逻辑，而不是简单地终\n止。",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "进程可以选择捕获并处理这些信号，从而在异常发生时执行自定义逻辑，而不是简单地终止。",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "UMKgq7vdhbF-OEnt0OcMO",
      "type": "text",
      "x": 1435.171474153176,
      "y": 7367.014875585041,
      "width": 640,
      "height": 25,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bHr",
      "roundness": null,
      "seed": 933339352,
      "version": 33,
      "versionNonce": 28267432,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1773798185724,
      "link": null,
      "locked": false,
      "text": "理解这一点，有助于深入理解进程崩溃、调试以及信号处理的工作原理。",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "理解这一点，有助于深入理解进程崩溃、调试以及信号处理的工作原理。",
      "autoResize": true,
      "lineHeight": 1.25
    },
