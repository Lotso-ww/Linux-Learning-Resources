    {
      "id": "6uhgXJTHjAzansopYEZhX",
      "type": "text",
      "x": 151.97140091098845,
      "y": 1907.914899999104,
      "width": 800,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
