    {
      "id": "Q08x68S3RpUfC-A2ctdPJ",
      "type": "text",
      "x": 31.571391755715013,
      "y": 330.01488321443594,
      "width": 60,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
