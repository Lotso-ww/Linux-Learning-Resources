    },
    {
      "id": "gmkq62Nxegc7dI8f_MQWE",
      "type": "text",
      "x": 1078.1315571609885,
      "y": 2636.5148755850414,
      "width": 790.8798828125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#e03131",
