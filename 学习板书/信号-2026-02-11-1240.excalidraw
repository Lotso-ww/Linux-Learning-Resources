      "link": null,
      "locked": false,
      "text": "作业是由进程组(一个进程也可以是一个进程组)来完成的，进程组是用来完成作业的。",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "作业是由进程组(一个进程也可以是一个进程组)来完成的，进程组是用来完成作业的。",
      "autoResize": true,
      "lineHeight": 1.25
    },
